# ==========================================
# PARKPULSE — ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connectivity
# For local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/parkpulse
# For MongoDB Atlas (production):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/parkpulse?retryWrites=true&w=majority

# JWT Security (REQUIRED — minimum 32 random characters in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_crypto_randomBytes_in_production

# CORS & Domain Whitelist (Comma-separated for multiple origins)
# In production, set to your deployed URL only:
# CORS_ORIGIN=https://your-app.onrender.com
CORS_ORIGIN=http://localhost:5000,http://localhost:5001

# Test Configuration (used by test scripts)
TEST_BASE_URL=http://localhost:5000
