# ========================================================
# PARKPULSE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ========================================================
# Copy this file to .env and configure for your environment:
#   cp .env.example .env

# Server Network Configuration
HOST=0.0.0.0
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/parkpulse
# MongoDB Atlas (Production Cloud):
# MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/parkpulse?retryWrites=true&w=majority

# JWT Signing Secret (Minimum 32 random characters in production)
# Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_crypto_randomBytes_in_production

# CORS Allowed Origins (Comma-separated)
# For GitHub Pages + Local Dev:
CORS_ORIGIN=https://satyamsingh1329.github.io,http://localhost:5000,http://localhost:5001

# Test Suite Base URL
TEST_BASE_URL=http://localhost:5000
